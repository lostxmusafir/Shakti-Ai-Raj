# Copy to .env for local development. Never commit real credentials.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=universal_ai_analyst
USE_MOCK_DB=true
JWT_SECRET_KEY=
AI_PROVIDER=zhipu
AI_MODEL=ministral-8b-latest
AI_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_DEFAULT_MODEL=ministral-8b-latest
MISTRAL_HIGHER_MODEL=codestral-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
ZHIPU_API_KEYS=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4.5-flash
SEED_ADMIN_EMAIL=admin@company.internal
SEED_ADMIN_PASSWORD=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_ANALYSES_PER_HOUR=30
