MISTRAL_DEFAULT_MODEL=ministral-8b-latest
MISTRAL_HIGHER_MODEL=codestral-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
ZHIPU_API_KEYS=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
