# ==========================================
# Universal AI Analyst - Environment Configuration
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Live MongoDB Atlas connection string (leave empty or default for local in-memory mock during tests)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=universal_ai_analyst
USE_MOCK_DB=true

# Security & Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-universal-ai-analyst-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800  # 50MB

# AI Provider Configuration
# Options: mock, gemini, openai
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Default Seed Super Admin
SEED_ADMIN_EMAIL=admin@company.internal
SEED_ADMIN_PASSWORD=AdminSecret123!
SEED_ADMIN_NAME=Super Administrator
